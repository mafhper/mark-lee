{
  "name": "mark-lee-desktop",
  "private": true,
  "version": "1.5.0",
  "description": "An elegant, high-performance Markdown editor built with React, Tauri, and Rust.",
  "author": "mafhper",
  "repository": {
    "type": "git",
    "url": "https://github.com/mafhper/mark-lee.git"
  },
  "type": "module",
  "scripts": {
    "predev": "node scripts/welcome.js",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "static-serve": "vite preview --host 0.0.0.0",
    "static-build": "npm run build && echo \"Build completo. Acesse os arquivos estáticos em dist/ ou use 'npm run static-serve'\"",
    "static-preview": "npm run build && vite preview --host 0.0.0.0",
    "smoke:install-browser": "playwright install chromium",
    "smoke:static": "npm run build && node scripts/smoke-static.mjs",
    "smoke:static:quick": "node scripts/smoke-static.mjs",
    "test:context-menu:unit": "node --experimental-strip-types --test src/app/components/context-menu/positionContextMenu.test.ts",
    "test:clipboard": "node --experimental-strip-types --test src/services/clipboard.test.ts",
    "test:editor-commands": "node --experimental-strip-types --test src/features/editor/editor-commands.test.ts",
    "test:image-markdown": "node --experimental-strip-types --test src/features/editor/image-markdown.test.ts",
    "test:preprocess-markdown": "node --experimental-strip-types --test src/app/markdown/preprocessMarkdown.test.ts",
    "test:preview-link": "node --experimental-strip-types --test src/app/markdown/resolvePreviewLink.test.ts",
    "test:commands": "node --experimental-strip-types --test src/app/commands/command.test.ts",
    "test:journal-entry": "node --experimental-strip-types --test src/features/journal/domain/journal-entry.test.ts",
    "test:journal-images": "node --experimental-strip-types --test src/features/journal/domain/entry-images.test.ts",
    "test:journal-tags": "node --experimental-strip-types --test src/features/journal/domain/tag-service.test.ts",
    "test:journal-tasks": "node --experimental-strip-types --test src/features/journal/domain/task-status.test.ts",
    "test:journal-order": "node --experimental-strip-types --test src/features/journal/domain/journal-order.test.ts",
    "test:export-html": "node --experimental-strip-types --test src/features/journal/domain/export-html.test.ts",
    "test:md-to-html": "node --experimental-strip-types --test src/features/journal/domain/md-to-html.test.ts",
    "test:export-paths": "node --experimental-strip-types --test src/features/journal/domain/export-paths.test.ts",
    "test:context-menu:playwright": "node scripts/test-context-menu.mjs",
    "test:context-menu": "npm run test:context-menu:unit && npm run test:context-menu:playwright",
    "test:ui-layout": "node scripts/ui_layout_regression_with_server.js",
    "test:release-workflow": "node scripts/release-workflow.test.mjs",
    "site:dev": "npm --prefix apps/site run dev",
    "site:build": "npm --prefix apps/site run build",
    "site:preview": "npm --prefix apps/site run preview",
    "site:check": "npm --prefix apps/site run check",
    "site:lint": "npm --prefix apps/site run lint",
    "site:test": "npm --prefix apps/site run test",
    "site:test:smoke": "npm run site:build && node scripts/smoke-site.mjs",
    "contrast:check": "node scripts/contrast-check.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:info": "tauri info",
    "release": "node scripts/release.js",
    "setup": "node scripts/setup.js",
    "icons": "node scripts/generate-icons.cjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-cli": "^2.4.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-window-state": "^2",
    "@uiw/react-codemirror": "^4.25.2",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/cli": "^2.10.1",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.22",
    "esbuild": "^0.28.0",
    "playwright": "^1.58.2",
    "postcss": "^8.5.25",
    "sharp": "^0.35.1",
    "tailwindcss": "^3.4.18",
    "typescript": "~7.0.2",
    "vite": "^8.0.11"
  }
}
