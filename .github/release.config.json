{
  "release": {
    "title": "Mark-Lee",
    "tagline": "Reúne um editor Markdown elegante e um espaço local-first de Memórias sobre os mesmos arquivos.",
    "language": "pt-BR",
    "image": {
      "path": "docs/images/releases",
      "required": true,
      "granularity": "minor",
      "prefix": "release",
      "ext": ".webp",
      "upload": true,
      "allow_correction": true
    },
    "notes": { "granularity": "minor" }
  },
  "build": {
    "package_manager": "npm",
    "node": "22.22.0",
    "rust": "stable",
    "working_directory": ".",
    "apt": [
      "libglib2.0-dev",
      "libgtk-3-dev",
      "libwebkit2gtk-4.1-dev",
      "libjavascriptcoregtk-4.1-dev",
      "libappindicator3-dev",
      "librsvg2-dev",
      "patchelf"
    ]
  },
  "desktop": {
    "enabled": true,
    "project_path": "."
  },
  "updater": {
    "enabled": true,
    "channel": "stable",
    "platforms": [
      {
        "id": "windows-x86_64",
        "os": ["windows-latest"],
        "sig": [
          "src-tauri/target/release/bundle/nsis/*x64*setup.exe.sig",
          "src-tauri/target/release/bundle/msi/*x64*.msi.sig"
        ]
      },
      {
        "id": "linux-x86_64",
        "os": ["ubuntu-latest"],
        "sig": ["src-tauri/target/release/bundle/appimage/*.AppImage.sig"]
      }
    ]
  },
  "versions": {
    "files": [
      { "path": "package.json", "format": "json", "field": "version" },
      { "path": "src-tauri/tauri.conf.json", "format": "json", "field": "version" },
      { "path": "src-tauri/Cargo.toml", "format": "toml", "field": "package.version" }
    ]
  }
}
