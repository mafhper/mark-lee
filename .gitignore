# Dependencies and build outputs
node_modules/
dist/
dist-ssr/
.turbo/
.cache/
coverage/
*.local

# Logs and diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
/performance-reports/
/output/

# Rust / Tauri
src-tauri/target/
src-tauri/gen/

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Project-local private workspaces
.worktrees/
@development/
.dev/
_dev/
/_development/
/docs/*
# Negations only work if git descends into docs/, so ignore its children rather
# than the directory itself — `/docs/` would make every exception below a no-op.
!/docs/plan/
!/docs/plan/change.log
!/docs/images/
/docs/images/*
# The release artwork is product, not development notes: Release Core reads it from
# the checked-out tag, so it has to be versioned or the image gate fails.
!/docs/images/releases/
!/docs/images/releases/*.webp

# Agent-private directories
.codex/
.agents/
.gemini/
.gemini-clipboard/
.claude/
.claude-code/
.qwen/
.kimi/
.roo/
.cursor/
.windsurf/

